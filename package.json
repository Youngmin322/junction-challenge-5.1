{
  "name": "junction-jellyfish",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,copilot,jellyguard -c cyan,green,magenta \"vinext dev --port 3100\" \"tsx watch server/index.ts\" \"backend/.venv/bin/jellyguard\"",
    "dev:web": "vinext dev --port 3100",
    "dev:copilot": "tsx watch server/index.ts",
    "dev:backend": "backend/.venv/bin/jellyguard",
    "dev:risk": "npm --prefix packages/risk-zone run demo",
    "build": "vinext build",
    "build:risk": "npm --prefix packages/risk-zone run build",
    "start": "vinext start",
    "lint": "eslint app server vite.config.ts next.config.ts --ignore-pattern dist --ignore-pattern .next",
    "test:risk": "npm --prefix packages/risk-zone test",
    "test:backend": "cd backend && .venv/bin/python -m pytest",
    "test": "npm run test:risk && npm run test:backend",
    "verify": "npm run lint && npm run build && npm run build:risk && npm test"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.11",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
