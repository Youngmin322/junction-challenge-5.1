# GitHub Copilot SDK. Copilot CLI에 로그인되어 있다면 토큰은 비워도 됩니다.
COPILOT_GITHUB_TOKEN=

# 로컬 서비스 연결
COPILOT_API_PORT=3001
NEXT_PUBLIC_COPILOT_API_BASE=http://localhost:3001
WEB_ORIGIN=http://localhost:3100
JELLYGUARD_API_BASE=http://127.0.0.1:8000
JELLYGUARD_LOCAL_REST_KEY=local-demo-key

# JellyGuard MCP 인증. REST 키와 다른 값을 사용하세요.
JELLYGUARD_MCP_CLIENT_KEY=mcp-demo-key

# 공공데이터 제공기관 키. 비워두면 fixture/synthetic 모드로 실행됩니다.
JELLYGUARD_NIFS_JELLY_KEY=
JELLYGUARD_NIFS_REDTIDE_KEY=
JELLYGUARD_NIFS_SOO_KEY=
JELLYGUARD_KHOA_KEY=

JELLYGUARD_SOURCE_MODE=fixture
JELLYGUARD_LIVE_ENABLED_SOURCES=
JELLYGUARD_LOCAL_DASHBOARD_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
